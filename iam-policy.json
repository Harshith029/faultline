{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDetectionWindows",
      "Effect": "Allow",
      "Action": ["dynamodb:Query"],
      "Resource": ["arn:aws:dynamodb:ap-south-1:*:table/Faultline-DriftSignals"]
    },
    {
      "Sid": "InvokeExplanationModel",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": [
        "arn:aws:bedrock:ap-south-1::foundation-model/anthropic.claude-3-haiku-20240307-v1:0"
      ]
    },
    {
      "Sid": "ReadLiveApiGatewayMetrics",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricData"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "AWS/ApiGateway"
        }
      }
    }
  ]
}
